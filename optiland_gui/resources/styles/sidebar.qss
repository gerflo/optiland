/* Sidebar layout-only rules shared by both themes.
   Colors stay in dark_theme.qss and light_theme.qss so the two themes
   cannot accidentally override each other with conflicting values. */

QLabel#SidebarTitleLabel {
    padding: 6px 0px;
}

QToolButton[objectName^="sidebar-btn-"] {
    border: none;
    padding: 8px 10px;
    text-align: left;
    border-radius: 6px;
}

#SidebarWidget[collapsed="true"] QToolButton[objectName^="sidebar-btn-"] {
    padding: 8px 6px;
}

QSplitter::handle:horizontal {
    width: 6px;
}
